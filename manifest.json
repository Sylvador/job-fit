{
    "manifest_version": 3,
    "name": "Job Fit for LinkedIn",
    "version": "1.0.0",
    "description": "On-demand: reads the LinkedIn job posting you're viewing and asks Gemini how well it matches your profile.",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Check job fit",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://generativelanguage.googleapis.com/*"
    ]
}